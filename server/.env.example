# ---------- Server ----------
PORT=5000
# Set to 127.0.0.1 on a server behind Nginx so the API is not exposed directly
HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS). First one is used in QR links.
CLIENT_URL=http://localhost:5173
# Optional: public site URL embedded in ticket QR codes (defaults to first CLIENT_URL)
PUBLIC_APP_URL=
# Number of reverse proxies in front of the app (1 on Render/Railway/Cloud Run)
TRUST_PROXY=false

# ---------- Firebase (Admin SDK) ----------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Option A: path to a service-account JSON file kept OUTSIDE the repo
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json
# Option B: base64 of the service-account JSON (for hosts with env-only secrets)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Local development against the emulator (optional)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# ---------- Admin provisioning ----------
ADMIN_EMAIL=admin@example.com

# ---------- Event details (shown on site, tickets and exports) ----------
EVENT_NAME=Dandiya Nights
EVENT_SUBTITLE=& Drawing & Rangoli Competition - on the same day
EVENT_TAGLINE=Come for the culture, stay for the vibes!
EVENT_DATE=Sunday, 18 October 2026
EVENT_TIME=Dandiya 5:00 PM - 10:00 PM
EVENT_COMPETITION_TIME=Competitions 10:00 AM - 12:00 PM (morning)
EVENT_VENUE=Jhira Function Hall, Bidar
EVENT_VENUE_MAP_URL=
EVENT_ORGANIZER=Team Agni - Bidar Vibes KA38
EVENT_CONTACT_PHONE=+91 63625 82268
EVENT_CONTACT_EMAIL=arthotthana@gmail.com
EVENT_COMPETITION_THEME=Devi Mata
EVENT_PRIZE_FIRST=₹3,100
EVENT_PRIZE_SECOND=₹2,100
# Comma-separated sponsor names shown on the website
EVENT_SPONSORS=Gudage Hospital,Hi-Fi Family Restaurant,Physics Wallah Bidar,Gurupadappa Nagampalli Speciality Co-operative Hospital,Beldale Foundation,Trishul Brand,Sudama Pohe,Vintage Retreat Resort,Hi-Ideals Technologies Pvt. Ltd.
# JPEG/PNG poster used in PDF tickets
EVENT_POSTER_PATH=assets/poster.jpg
REGISTRATION_OPEN=true

# ---------- Pricing override (optional, integer paise) ----------
# PRICING_CONFIG_JSON={"version":"2027-v1","currency":"INR","maxTicketsPerBooking":7,"competitionChargeMode":"per_registration","categories":{"couple":{"label":"Couple","basePaise":49900,"platformFeePaise":2100},"single":{"label":"Single","basePaise":19900,"platformFeePaise":1100}},"competitions":{"rangoli":{"label":"Rangoli Competition","basePaise":9900,"platformFeePaise":1100},"drawing":{"label":"Drawing Competition","basePaise":9900,"platformFeePaise":1100}}}
