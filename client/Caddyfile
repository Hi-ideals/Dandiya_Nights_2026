{
	# Let's Encrypt account email (expiry notices). Set ACME_EMAIL in the root .env.
	email {$ACME_EMAIL}

	servers {
		# Keep the real visitor IP when another proxy (e.g. Apache) sits in front.
		trusted_proxies static private_ranges
	}
}

# SITE_ADDRESS is the domain (Caddy gets HTTPS itself) or ":80" when an existing
# web server such as Apache terminates HTTPS in front (docker-compose.apache.yml).
{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	# Backend API (keeps the /api prefix). Caddy sets X-Forwarded-For/Proto.
	handle /api/* {
		reverse_proxy api:5000
	}

	# Hashed build assets: cache forever.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Single-page app: unknown paths serve index.html, which is never cached.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
