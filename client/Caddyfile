{
	# Let's Encrypt account email (expiry notices). Set ACME_EMAIL in the root .env.
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Backend API (keeps the /api prefix). Caddy sets X-Forwarded-For/Proto.
	handle /api/* {
		reverse_proxy api:5000
	}

	# Hashed build assets: cache forever.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Single-page app: unknown paths serve index.html, which is never cached.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
