# Firebase web app config (Project settings -> General -> Your apps). Used only for admin login.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Backend API base URL. "/api" uses the Vite dev proxy to http://localhost:5000.
# Production example: https://dandiya-api.onrender.com/api
VITE_API_BASE_URL=/api

# Optional: use the Firebase Auth emulator in development
# VITE_USE_AUTH_EMULATOR=true
