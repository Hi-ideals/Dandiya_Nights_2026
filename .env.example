# Docker Compose settings. Copy to .env next to docker-compose.yml.
# Public domain of the site (DNS A record must point to this server)
DOMAIN=dandiyanight.arthotthanaparishat.in
# Email for Let's Encrypt certificate notices
ACME_EMAIL=you@example.com
# Server already runs Apache on ports 80/443? Uncomment to run behind it
# (Apache proxies the domain to 127.0.0.1:8080, see deploy/apache-dandiya.conf).
# COMPOSE_FILE=docker-compose.yml:docker-compose.apache.yml
